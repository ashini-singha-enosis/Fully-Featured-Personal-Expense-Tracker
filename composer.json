{
    "name": "local/fully-featured-personal-expense-tracker",
    "description": "Personal Expense Tracker with Doctrine, DI, PHPMailer, PHPUnit, and REST API",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "doctrine/orm": "^2.19",
        "doctrine/dbal": "^3.9",
        "phpmailer/phpmailer": "^6.9",
        "symfony/cache": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
